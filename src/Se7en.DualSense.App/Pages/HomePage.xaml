<UserControl x:Class="Se7en.DualSense.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Se7en.DualSense.App.Controls">
    <StackPanel>
        <!-- ───────────── Bandeau : pilotes manquants / droits administrateur ───────────── -->
        <ContentControl x:Name="DriverBanner" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Warning.Soft}" VerticalAlignment="Center">
                    <c:AxisIcon Data="{StaticResource Icon.TriangleAlert}" Width="18" Height="18" Foreground="{DynamicResource Warning}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DriverTitle" Text="Pilotes manquants" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                    <TextBlock x:Name="DriverText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="DriverButton" Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Installer" Click="OnDriverButtonClick" VerticalAlignment="Center" />
            </Grid>
        </ContentControl>

        <!-- ───────────── Alerte : drift détecté ───────────── -->
        <ContentControl x:Name="DriftCard" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Danger.Soft}" VerticalAlignment="Center">
                    <c:AxisIcon Data="{StaticResource Icon.TriangleAlert}" Width="18" Height="18" Foreground="{DynamicResource Danger}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Drift détecté" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                    <TextBlock Text="Un stick dérive au repos au-delà de sa zone morte. Une calibration de quelques secondes suffit en général." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Corriger" Click="OnFixDriftClick" VerticalAlignment="Center" />
            </Grid>
        </ContentControl>

        <!-- ───────────── Héros éditorial : grille pointillée, typo géante, manette devant ───────────── -->
        <Grid Margin="0,0,0,28">
            <Border CornerRadius="8" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" />
            <Grid c:RoundedClip.Radius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Filets pointillés -->
                <Line Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource Rule.H}" VerticalAlignment="Top" Margin="0,44,0,0" />
                <Line Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource Rule.H}" VerticalAlignment="Bottom" Margin="0,0,0,44" />
                <Line Grid.RowSpan="2" Style="{StaticResource Rule.V}" HorizontalAlignment="Left" Margin="32,0,0,0" />
                <Line Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Rule.V}" HorizontalAlignment="Left" />

                <!-- Typo display géante en encre -->
                <TextBlock Grid.ColumnSpan="2" Text="DUALSENSE" FontFamily="{StaticResource Font.Display}" FontSize="186"
                           Foreground="{DynamicResource Ink}" Margin="48,40,0,0" LineHeight="160" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="NoWrap" />

                <!-- Colonne gauche : état, accroche, actions -->
                <StackPanel Grid.Row="1" Margin="48,28,24,64">
                    <WrapPanel Margin="0,0,0,10">
                        <c:Badge x:Name="StatusBadge" ShowDot="True" Text="Déconnectée" Tone="Neutral" Margin="0,0,8,8" />
                        <c:Badge x:Name="LinkBadge" Text="USB" Visibility="Collapsed" Margin="0,0,8,8" />
                        <c:Badge x:Name="OutputBadge" Text="—" Tone="Accent" Margin="0,0,8,8" />
                        <c:Badge x:Name="ProfileBadge" Text="Par défaut" Tone="Inverse" Margin="0,0,8,8" />
                        <c:Badge x:Name="DemoBadge" Text="Mode démo" Tone="Highlight" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock Text="Votre manette, dans tous vos jeux." Style="{StaticResource Text.H1}" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" />
                    <TextBlock x:Name="HeroHint" Style="{StaticResource Text.Body}" Margin="0,12,0,20" MaxWidth="340" HorizontalAlignment="Left"
                               Text="En attente de la manette. Branchez-la en USB ou connectez-la en Bluetooth." />

                    <TextBlock Text="LES JEUX VOIENT" Style="{StaticResource Text.Overline}" Margin="0,0,0,8" />
                    <Border CornerRadius="20" Background="{DynamicResource Surface.Inset}" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeDs4" Style="{StaticResource Segment}" GroupName="OutputMode" Content="DualShock 4" Checked="OnModeChecked" />
                            <RadioButton x:Name="ModeXbox" Style="{StaticResource Segment}" GroupName="OutputMode" Content="Xbox 360" Checked="OnModeChecked" />
                            <RadioButton x:Name="ModeNative" Style="{StaticResource Segment}" GroupName="OutputMode" Content="DualSense native" Checked="OnModeChecked" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ModeMessage" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" Margin="0,10,0,24" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton.Outline}" ToolTip="Profils" Click="OnProfilesClick" Margin="0,0,8,0">
                            <c:AxisIcon Data="{StaticResource Icon.Box}" Width="18" Height="18"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Height="46" Padding="24,0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnCustomizeClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="23" Background="{DynamicResource Ink}" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="Txt" Text="Personnaliser" FontFamily="{StaticResource Font.Sans}" FontSize="15" FontWeight="Medium"
                                                       Foreground="{DynamicResource OnInk}" VerticalAlignment="Center" />
                                            <c:AxisIcon x:Name="Arrow" Data="{StaticResource Icon.ArrowUpRight}" Width="18" Height="18" Margin="10,0,0,0"
                                                        Foreground="{DynamicResource OnInk}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Colonne droite : la manette en direct, devant la typo, et le tampon -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <c:DualSenseView x:Name="Controller" ShowInputOverlays="False" Width="470" Height="391" Margin="0,-150,0,-10" VerticalAlignment="Top" HorizontalAlignment="Center" />
                    <c:StampBadge x:Name="Stamp" Value="—" Caption="BATTERIE" Width="112" Height="112"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,28" RenderTransformOrigin="0.5,0.5">
                        <c:StampBadge.RenderTransform><RotateTransform Angle="-8" /></c:StampBadge.RenderTransform>
                    </c:StampBadge>
                </Grid>
            </Grid>
        </Grid>

        <!-- ───────────── Entrées en direct ───────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="STICK GAUCHE" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="Valeurs brutes" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                    <c:StickVisualizer x:Name="LeftStickViz" Width="150" Height="150" />
                    <TextBlock x:Name="LeftStickReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="X +0.000  Y +0.000" />
                    <TextBlock x:Name="LeftStickRaw" Style="{StaticResource Text.Readout}" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Text="brut 128 · 128" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="STICK DROIT" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="Valeurs brutes" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                    <c:StickVisualizer x:Name="RightStickViz" Width="150" Height="150" />
                    <TextBlock x:Name="RightStickReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="X +0.000  Y +0.000" />
                    <TextBlock x:Name="RightStickRaw" Style="{StaticResource Text.Readout}" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Text="brut 128 · 128" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="4" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="GÂCHETTES" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="L2 / R2" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,22,0">
                            <c:TriggerMeter x:Name="L2Meter" Width="30" Height="140" />
                            <TextBlock Text="L2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="L2Readout" Text="0%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <c:TriggerMeter x:Name="R2Meter" Width="30" Height="140" />
                            <TextBlock Text="R2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="R2Readout" Text="0%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="6" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="PAVÉ TACTILE" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="Position des doigts" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                    <c:TouchpadVisual x:Name="TouchViz" Height="118" />
                    <TextBlock x:Name="TouchReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="Aucun contact" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ───────────── Boutons : chaque touche s'allume quand elle est enfoncée ───────────── -->
        <ContentControl Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="BOUTONS" Style="{StaticResource Text.Overline}" />
                <TextBlock Text="Appuyez sur une touche de la manette" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                <WrapPanel x:Name="ButtonsPanel" />
                <TextBlock x:Name="ButtonsReadout" Style="{StaticResource Text.Readout}" Foreground="{DynamicResource Text.Tertiary}" Text="Aucune touche"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ContentControl>

        <!-- ───────────── Chiffres clés (Anton) ───────────── -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Activity}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="FRÉQUENCE" Style="{StaticResource Text.Overline}" />
                    </DockPanel>
                    <TextBlock x:Name="RateValue" Text="—" Style="{StaticResource Text.Stat}" Margin="0,16,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon x:Name="LinkIcon" DockPanel.Dock="Right" Data="{StaticResource Icon.Usb}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="CONNEXION" Style="{StaticResource Text.Overline}" />
                    </DockPanel>
                    <TextBlock x:Name="LinkValue" Text="AUCUNE" Style="{StaticResource Text.Stat}" Margin="0,16,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="4" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Layers}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="MODE DE SORTIE" Style="{StaticResource Text.Overline}" />
                    </DockPanel>
                    <TextBlock x:Name="ModeStat" Text="—" Style="{StaticResource Text.Stat}" Margin="0,16,0,0" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </StackPanel>
</UserControl>
