<UserControl x:Class="Se7en.DualSense.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Se7en.DualSense.App.Controls">
    <StackPanel>
        <!-- ───────────── Héros : la manette au centre (référence « DualSense » neumorphique) ───────────── -->
        <Grid Height="720" Margin="0,0,0,28">
            <Border CornerRadius="28" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.Highlight}" />
            <Border CornerRadius="28" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.Low}" />
            <Grid c:RoundedClip.Radius="28">
                <c:ChevronLines />

                <!-- Haut gauche : état -->
                <c:Badge x:Name="StatusBadge" ShowDot="True" Text="Déconnectée" Tone="Neutral"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,34,0,0" />

                <!-- Haut droite : connexion + batterie -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,40,0">
                    <c:AxisIcon x:Name="HeroLinkIcon" Data="{StaticResource Icon.Usb}" Width="16" Height="16" Margin="0,0,12,0" Visibility="Collapsed" />
                    <c:BatteryMeter x:Name="Battery" Visibility="Collapsed" />
                </StackPanel>

                <!-- Colonne gauche : indicateurs -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="62,0,0,0">
                    <c:AxisIcon x:Name="SideLink" Data="{StaticResource Icon.Usb}" Width="17" Height="17" Margin="0,0,0,32" ToolTip="Connexion" Foreground="{DynamicResource Text.Tertiary}" />
                    <c:AxisIcon x:Name="SidePower" Data="{StaticResource Icon.Zap}" Width="17" Height="17" Margin="0,0,0,32" ToolTip="Charge" Foreground="{DynamicResource Text.Tertiary}" />
                    <c:AxisIcon x:Name="SideActivity" Data="{StaticResource Icon.Activity}" Width="17" Height="17" ToolTip="Activité" Foreground="{DynamicResource Text.Tertiary}" />
                </StackPanel>

                <!-- Centre -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="DualSense" Style="{StaticResource Text.Base}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="3" Direction="290" BlurRadius="8" Opacity="0.28" Color="#3C4152" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <c:DualSenseView x:Name="Controller" Width="540" Height="449" Margin="0,8,0,-24" />

                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1" VerticalAlignment="Center" />
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource Text.Primary}" Margin="12,0" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="HeroHint" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Primary}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,22,0,0" LineHeight="18"
                               Text="En attente de la manette. Branchez-la en USB ou connectez-la en Bluetooth." />

                    <Button x:Name="CalibrateButton" Style="{StaticResource Button.Secondary}" Content="Calibrer les sticks"
                            HorizontalAlignment="Center" Margin="0,26,0,0" MinWidth="150" Click="OnCalibrateClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ───────────── Entrées en direct ───────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stick gauche" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="Valeurs brutes" Style="{StaticResource Text.Caption}" Margin="0,3,0,16" />
                    <c:StickVisualizer x:Name="LeftStickViz" Width="150" Height="150" />
                    <TextBlock x:Name="LeftStickReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="X +0.000  Y +0.000" />
                    <TextBlock x:Name="LeftStickRaw" Style="{StaticResource Text.Readout}" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Text="brut 128 · 128" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stick droit" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="Valeurs brutes" Style="{StaticResource Text.Caption}" Margin="0,3,0,16" />
                    <c:StickVisualizer x:Name="RightStickViz" Width="150" Height="150" />
                    <TextBlock x:Name="RightStickReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="X +0.000  Y +0.000" />
                    <TextBlock x:Name="RightStickRaw" Style="{StaticResource Text.Readout}" Foreground="{DynamicResource Text.Tertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Text="brut 128 · 128" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="4" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Gâchettes" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="L2 / R2" Style="{StaticResource Text.Caption}" Margin="0,3,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,22,0">
                            <c:TriggerMeter x:Name="L2Meter" Width="30" Height="140" />
                            <TextBlock Text="L2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="L2Readout" Text="0%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <c:TriggerMeter x:Name="R2Meter" Width="30" Height="140" />
                            <TextBlock Text="R2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="R2Readout" Text="0%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="6" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Pavé tactile" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="Position des doigts" Style="{StaticResource Text.Caption}" Margin="0,3,0,16" />
                    <c:TouchpadVisual x:Name="TouchViz" Height="118" />
                    <TextBlock x:Name="TouchReadout" Style="{StaticResource Text.Readout}" HorizontalAlignment="Center" Margin="0,14,0,0" Text="Aucun contact" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ───────────── Chiffres clés ───────────── -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Activity}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="Fréquence de la manette" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}" />
                    </DockPanel>
                    <TextBlock x:Name="RateValue" Text="—" FontSize="26" FontWeight="Medium" Style="{StaticResource Text.Base}" Margin="0,18,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon x:Name="LinkIcon" DockPanel.Dock="Right" Data="{StaticResource Icon.Usb}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="Connexion" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}" />
                    </DockPanel>
                    <TextBlock x:Name="LinkValue" Text="Aucune" FontSize="26" FontWeight="Medium" Style="{StaticResource Text.Base}" Margin="0,18,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="4" Style="{StaticResource Card.Small}">
                <StackPanel>
                    <DockPanel>
                        <c:AxisIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Layers}" Width="16" Height="16" Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="Mode de sortie" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}" />
                    </DockPanel>
                    <TextBlock Text="Lecture seule" FontSize="26" FontWeight="Medium" Style="{StaticResource Text.Base}" Margin="0,18,0,0" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </StackPanel>
</UserControl>
