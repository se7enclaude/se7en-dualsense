<UserControl x:Class="Se7en.DualSense.App.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Se7en.DualSense.App.Controls"
             ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}">
    <!--
        Écran d'ouverture : animation du titre « se7en DualSense », puis scène sombre avec la manette 3D en direct.
        Scène 1440 × 900 mise à l'échelle sans recadrage ; le fond sombre remplit toute la fenêtre.
    -->
    <UserControl.Resources>
        <Style x:Key="NavLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,34,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <ContentPresenter Margin="0,4" />
                            <Rectangle x:Name="Under" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource Highlight}" Opacity="0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Under" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal citron -->
        <Style x:Key="Cta" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="28" Height="56" Padding="30,0" Background="{DynamicResource Highlight}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Font.Sans}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111114" VerticalAlignment="Center" />
                                <c:AxisIcon x:Name="Arrow" Data="{StaticResource Icon.ArrowRight}" Width="19" Height="19" Margin="12,0,0,0" Foreground="#111114">
                                    <c:AxisIcon.RenderTransform><TranslateTransform x:Name="ArrowShift" /></c:AxisIcon.RenderTransform>
                                </c:AxisIcon>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="5" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire transparent -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="28" Height="56" Padding="26,0" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Font.Sans}" FontSize="16" FontWeight="Medium"
                                       Foreground="White" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petite carte « point fort » en verre fumé -->
        <Style x:Key="Feature" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Width" Value="232" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#17171D" Offset="0" />
                <GradientStop Color="#0B0B0E" Offset="0.55" />
                <GradientStop Color="#060608" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox Stretch="Uniform">
            <Canvas x:Name="Scene" Width="1440" Height="900" ClipToBounds="True">

                <!-- ═══════════ Décor ═══════════ -->
                <!-- Halo de la couleur d'accent derrière la manette (suit un peu la souris) -->
                <Ellipse x:Name="Glow" Canvas.Left="640" Canvas.Top="150" Width="820" Height="620" Opacity="0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="GlowShift" /></Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Petit halo citron en bas à gauche -->
                <Ellipse x:Name="Glow2" Canvas.Left="-200" Canvas.Top="-260" Width="640" Height="560" Opacity="0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1FD4F53C" Offset="0" />
                            <GradientStop Color="#00D4F53C" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Grille de filets pointillés -->
                <Canvas x:Name="Grid" Opacity="0" IsHitTestVisible="False">
                    <Line X1="0" Y1="118" X2="1440" Y2="118" Stroke="#17FFFFFF" StrokeDashArray="3 4" />
                    <Line X1="0" Y1="790" X2="1440" Y2="790" Stroke="#17FFFFFF" StrokeDashArray="3 4" />
                    <Line X1="96" Y1="0" X2="96" Y2="900" Stroke="#17FFFFFF" StrokeDashArray="3 4" />
                    <Line X1="1344" Y1="0" X2="1344" Y2="900" Stroke="#17FFFFFF" StrokeDashArray="3 4" />
                </Canvas>

                <!-- Typo fantôme derrière la manette : contour très discret -->
                <TextBlock x:Name="GhostText" Text="DUALSENSE" Canvas.Left="452" Canvas.Top="300" FontFamily="{StaticResource Font.Display}" FontSize="230"
                           Foreground="#0AFFFFFF" Opacity="0" IsHitTestVisible="False">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="GhostShift" /></TextBlock.RenderTransform>
                </TextBlock>

                <!-- ═══════════ Manette 3D ═══════════ -->
                <ContentControl x:Name="ControllerHost" Canvas.Left="660" Canvas.Top="150" Width="760" Height="600" Opacity="0" Focusable="False"
                                RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ControllerScale" />
                            <TranslateTransform x:Name="ControllerShift" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
                <TextBlock x:Name="DragHint" Text="Glissez la manette pour la faire tourner" Canvas.Left="900" Canvas.Top="752" FontFamily="{StaticResource Font.Sans}"
                           FontSize="12" Foreground="#59FFFFFF" Opacity="0" IsHitTestVisible="False" />

                <!-- ═══════════ Barre du haut ═══════════ -->
                <StackPanel x:Name="Brand" Orientation="Horizontal" Canvas.Left="96" Canvas.Top="44" Opacity="0">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="BrandShift" /></StackPanel.RenderTransform>
                    <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="se7en" FontFamily="{StaticResource Font.Brand}" FontSize="26" Foreground="White" VerticalAlignment="Center" Margin="14,-4,0,0" />
                </StackPanel>
                <StackPanel x:Name="Nav" Orientation="Horizontal" Canvas.Right="96" Canvas.Top="52" Opacity="0">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="NavShift" /></StackPanel.RenderTransform>
                    <Button Style="{StaticResource NavLink}" Content="Calibration" Tag="calibration" Click="OnNavClick" />
                    <Button Style="{StaticResource NavLink}" Content="Mappage" Tag="mapping" Click="OnNavClick" />
                    <Button Style="{StaticResource NavLink}" Content="Jeux" Tag="games" Click="OnNavClick" Margin="0" />
                </StackPanel>

                <!-- ═══════════ Accroche ═══════════ -->
                <StackPanel x:Name="Copy" Canvas.Left="96" Canvas.Top="232" Width="560">
                    <StackPanel x:Name="Overline" Orientation="Horizontal" Opacity="0">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="OverlineShift" /></StackPanel.RenderTransform>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Highlight}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="MANETTE PS5 · PC" FontFamily="{StaticResource Font.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Highlight}" />
                    </StackPanel>
                    <TextBlock x:Name="Headline1" Text="Votre DualSense," FontFamily="{StaticResource Font.Sans}" FontWeight="SemiBold" FontSize="64"
                               Foreground="White" Margin="0,20,0,0" Opacity="0">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="Headline1Shift" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="Headline2" FontFamily="{StaticResource Font.Sans}" FontWeight="SemiBold" FontSize="64" Opacity="0" Margin="0,-6,0,0">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="Headline2Shift" /></TextBlock.RenderTransform>
                        <Run Text="dans " Foreground="White" /><Run Text="tous vos jeux." Foreground="{DynamicResource Highlight}" />
                    </TextBlock>
                    <TextBlock x:Name="Subtitle" FontFamily="{StaticResource Font.Sans}" FontSize="19" LineHeight="29" Foreground="#A6FFFFFF" TextWrapping="Wrap"
                               Margin="0,22,0,0" Opacity="0" MaxWidth="470" HorizontalAlignment="Left"
                               Text="Icônes PlayStation, anti-drift, profils par jeu : branchez la manette, jouez.">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="SubtitleShift" /></TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- État de la manette, en direct -->
                    <Border x:Name="Status" CornerRadius="16" Padding="14,8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,26,0,0" Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="StatusText" Text="En attente de la manette" FontFamily="{StaticResource Font.Sans}" FontSize="13" Foreground="#D9FFFFFF" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,30,0,0" Opacity="0">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="ActionsShift" /></StackPanel.RenderTransform>
                        <Button x:Name="CtaButton" Style="{StaticResource Cta}" Content="Entrer" Click="OnCtaClick" />
                        <Button Style="{StaticResource Ghost}" Content="Mes profils" Tag="games" Click="OnNavClick" Margin="12,0,0,0" />
                        <TextBlock Text="ou Entrée" FontFamily="{StaticResource Font.Sans}" FontSize="12" Foreground="#59FFFFFF" VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════ Points forts ═══════════ -->
                <StackPanel x:Name="Features" Orientation="Horizontal" Canvas.Left="96" Canvas.Top="812" Opacity="0">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="FeaturesShift" /></StackPanel.RenderTransform>
                    <Border Style="{StaticResource Feature}" Padding="0" Background="Transparent" BorderThickness="0" Width="220">
                        <StackPanel Orientation="Horizontal">
                            <c:AxisIcon Data="{StaticResource Icon.Target}" Width="18" Height="18" Foreground="{DynamicResource Highlight}" Margin="0,0,10,0" />
                            <TextBlock Text="Anti-drift automatique" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}" Padding="0" Background="Transparent" BorderThickness="0" Width="250">
                        <StackPanel Orientation="Horizontal">
                            <c:AxisIcon Data="{StaticResource Icon.Gamepad2}" Width="18" Height="18" Foreground="{DynamicResource Highlight}" Margin="0,0,10,0" />
                            <TextBlock Text="DualShock 4, Xbox ou native" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}" Padding="0" Background="Transparent" BorderThickness="0" Width="200">
                        <StackPanel Orientation="Horizontal">
                            <c:AxisIcon Data="{StaticResource Icon.Layers}" Width="18" Height="18" Foreground="{DynamicResource Highlight}" Margin="0,0,10,0" />
                            <TextBlock Text="Un profil par jeu" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}" Padding="0" Background="Transparent" BorderThickness="0" Width="220">
                        <StackPanel Orientation="Horizontal">
                            <c:AxisIcon Data="{StaticResource Icon.Vibrate}" Width="18" Height="18" Foreground="{DynamicResource Highlight}" Margin="0,0,10,0" />
                            <TextBlock Text="Haptique et lumière" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ Intro : « se7en DualSense » ═══════════ -->
                <Grid x:Name="Intro" Width="1440" Height="900" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="IntroScale" /></Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                        <StackPanel x:Name="IntroWord1" Orientation="Horizontal" HorizontalAlignment="Center" />
                        <StackPanel x:Name="IntroWord2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Rectangle x:Name="IntroLine" Height="3" Width="0" Margin="0,26,0,0" HorizontalAlignment="Center" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D4F53C" Offset="0" />
                                    <GradientStop Color="#FFD4F53C" Offset="0.5" />
                                    <GradientStop Color="#00D4F53C" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect><DropShadowEffect Color="#D4F53C" ShadowDepth="0" BlurRadius="16" Opacity="0.8" /></Rectangle.Effect>
                        </Rectangle>
                    </StackPanel>
                </Grid>
            </Canvas>
        </Viewbox>

        <!-- Indication pour passer l'intro -->
        <TextBlock x:Name="SkipHint" Text="Cliquez pour passer" FontFamily="{StaticResource Font.Sans}" FontSize="12" Foreground="#80FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" IsHitTestVisible="False" />
    </Grid>
</UserControl>
