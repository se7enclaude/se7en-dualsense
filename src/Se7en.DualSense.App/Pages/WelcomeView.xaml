<UserControl x:Class="Se7en.DualSense.App.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Se7en.DualSense.App.Controls"
             ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}">
    <!--
        Écran d'ouverture : animation du titre « se7en DualSense », puis accueil
        « Découvrez —DualSense » avec la manette au premier plan. Scène 1440 × 900 mise à l'échelle.
    -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="DualBrush" StartPoint="0,0" EndPoint="1,0.4">
            <GradientStop Color="#B687E5" Offset="0" />
            <GradientStop Color="#A592E9" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SenseBrush" StartPoint="0,0" EndPoint="1,0.4">
            <GradientStop Color="#9E97EA" Offset="0" />
            <GradientStop Color="#8F9BEA" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="NavLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,36,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="0,4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cta" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="26" Height="52" Padding="30,0" Background="{DynamicResource Ink}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontFamily="{StaticResource Font.Sans}" FontSize="19" FontWeight="Medium"
                                           Foreground="{DynamicResource OnInk}" VerticalAlignment="Center" />
                                <c:AxisIcon x:Name="Arrow" Data="{StaticResource Icon.ArrowUpRight}" Width="20" Height="20" Margin="12,0,0,0" Foreground="{DynamicResource OnInk}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Surface.Solid}">
        <Viewbox Stretch="UniformToFill">
            <Canvas x:Name="Scene" Width="1440" Height="900" ClipToBounds="True">

                <!-- ═══════════ Accueil ═══════════ -->

                <!-- Typo display géante -->
                <TextBlock x:Name="DualText" Text="DUAL" Canvas.Left="57" Canvas.Top="-195" FontFamily="{StaticResource Font.Display}"
                           FontSize="460" Foreground="{StaticResource DualBrush}" Opacity="0">
                    <TextBlock.RenderTransform><TransformGroup><ScaleTransform ScaleX="1.14" /><TranslateTransform x:Name="DualShift" /></TransformGroup></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SenseText" Text="SENSE" Canvas.Left="735" Canvas.Top="339" FontFamily="{StaticResource Font.Display}"
                           FontSize="460" Foreground="{StaticResource SenseBrush}" Opacity="0">
                    <TextBlock.RenderTransform><TransformGroup><ScaleTransform ScaleX="1.14" /><TranslateTransform x:Name="SenseShift" /></TransformGroup></TextBlock.RenderTransform>
                </TextBlock>

                <!-- Grille de filets pointillés -->
                <Canvas x:Name="Grid" Opacity="0" IsHitTestVisible="False">
                    <Line X1="0" Y1="226" X2="1440" Y2="226" Style="{StaticResource Rule.H}" Stretch="None" />
                    <Line X1="0" Y1="812" X2="1440" Y2="812" Style="{StaticResource Rule.H}" Stretch="None" />
                    <Line X1="330" Y1="0" X2="330" Y2="900" Style="{StaticResource Rule.V}" Stretch="None" />
                    <Line X1="1352" Y1="0" X2="1352" Y2="900" Style="{StaticResource Rule.V}" Stretch="None" />
                    <Path Canvas.Left="1370" Canvas.Top="830" Data="M 0,11 L 7,0 L 14,11 Z M 0,26 L 7,15 L 14,26 Z M 0,41 L 7,30 L 14,41 Z" Fill="{DynamicResource Ink}" />
                </Canvas>

                <!-- Ombre portée douce sous la manette -->
                <Ellipse x:Name="ControllerShadow" Canvas.Left="730" Canvas.Top="690" Width="580" Height="80" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="ShadowScale" /></Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66181C2C" Offset="0" />
                            <GradientStop Color="#00181C2C" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="24" /></Ellipse.Effect>
                </Ellipse>

                <!-- Manette au premier plan (photo nette, de face) -->
                <Viewbox x:Name="Controller" Canvas.Left="700" Canvas.Top="235" Width="644" Height="492" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.Effect><DropShadowEffect Color="#181C2C" Direction="270" ShadowDepth="22" BlurRadius="48" Opacity="0.22" /></Viewbox.Effect>
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ControllerScale" />
                            <RotateTransform x:Name="ControllerRotate" />
                            <TranslateTransform x:Name="ControllerShift" />
                        </TransformGroup>
                    </Viewbox.RenderTransform>
                    <Canvas Width="505" Height="386">
                        <Path x:Name="LightbarGlowL" Data="M 162,45 C 166,75 171,100 180,118" Stroke="#4B57F5" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                            <Path.Effect><BlurEffect Radius="12" /></Path.Effect>
                        </Path>
                        <Path x:Name="LightbarGlowR" Data="M 343,45 C 339,75 334,100 325,118" Stroke="#4B57F5" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                            <Path.Effect><BlurEffect Radius="12" /></Path.Effect>
                        </Path>
                        <Image x:Name="Photo" Width="505" Height="386" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                </Viewbox>

                <!-- Logo -->
                <Canvas x:Name="Logo" Canvas.Left="79" Canvas.Top="128" Width="60" Height="56" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="LogoScale" /></Canvas.RenderTransform>
                    <Image Source="/Assets/logo.png" Width="52" Height="52" Canvas.Left="2" Canvas.Top="2" RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>

                <!-- Menu + marque -->
                <StackPanel x:Name="Nav" Orientation="Horizontal" Canvas.Left="925" Canvas.Top="136" Opacity="0">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="NavShift" /></StackPanel.RenderTransform>
                    <Button Style="{StaticResource NavLink}" Content="Calibration" Tag="calibration" Click="OnNavClick" />
                    <Button Style="{StaticResource NavLink}" Content="Mappage" Tag="mapping" Click="OnNavClick" />
                    <Button Style="{StaticResource NavLink}" Content="Jeux" Tag="games" Click="OnNavClick" Margin="0,0,44,0" />
                    <TextBlock Text="se7en" FontFamily="{StaticResource Font.Brand}" FontSize="26"
                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="0,-6,0,0" />
                </StackPanel>

                <!-- Accroche -->
                <TextBlock x:Name="Headline1" Text="Découvrez" Canvas.Left="160" Canvas.Top="428" FontFamily="{StaticResource Font.Sans}"
                           FontWeight="Medium" FontSize="68" Foreground="{DynamicResource Text.Primary}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Headline1Shift" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Headline2" Text="—DualSense" Canvas.Left="160" Canvas.Top="498" FontFamily="{StaticResource Font.Sans}"
                           FontWeight="Medium" FontSize="68" Foreground="{DynamicResource Text.Primary}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Headline2Shift" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Subtitle" Canvas.Left="162" Canvas.Top="604" FontFamily="{StaticResource Font.Sans}" FontSize="22" LineHeight="30"
                           Foreground="{DynamicResource Text.Secondary}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="SubtitleShift" /></TextBlock.RenderTransform>
                    <Run Text="Votre manette PS5, prête pour" /><LineBreak /><Run Text="tous vos jeux PC." />
                </TextBlock>
                <Button x:Name="ProfilesButton" Canvas.Left="160" Canvas.Top="692" Width="52" Height="52" Opacity="0" Click="OnNavClick" Tag="games"
                        Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Profils">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="26" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" Background="Transparent">
                                <c:AxisIcon x:Name="Ico" Data="{StaticResource Icon.Box}" Width="20" Height="20" Foreground="{DynamicResource Text.Primary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}" />
                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource OnInk}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CtaButton" Style="{StaticResource Cta}" Content="Personnaliser" Canvas.Left="222" Canvas.Top="692"
                        Click="OnCtaClick" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform x:Name="CtaScale" /></Button.RenderTransform>
                </Button>

                <!-- Curseur décoratif : point + anneau qui suivent la souris -->
                <Canvas x:Name="CursorLayer" IsHitTestVisible="False" Opacity="0">
                    <Ellipse x:Name="CursorRing" Width="86" Height="86" Stroke="#C9CCD6" StrokeThickness="1.5" />
                    <Ellipse x:Name="CursorDot" Width="32" Height="32" Fill="{DynamicResource Accent}" />
                </Canvas>

                <!-- ═══════════ Intro : « se7en DualSense » ═══════════ -->
                <Grid x:Name="Intro" Width="1440" Height="900" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="IntroScale" /></Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                        <StackPanel x:Name="IntroWord1" Orientation="Horizontal" HorizontalAlignment="Center" />
                        <StackPanel x:Name="IntroWord2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Rectangle x:Name="IntroLine" Height="3" Width="0" Margin="0,26,0,0" HorizontalAlignment="Center" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#004B57F5" Offset="0" />
                                    <GradientStop Color="#FF4B57F5" Offset="0.5" />
                                    <GradientStop Color="#004B57F5" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect><DropShadowEffect Color="#4B57F5" ShadowDepth="0" BlurRadius="16" Opacity="0.8" /></Rectangle.Effect>
                        </Rectangle>
                    </StackPanel>
                </Grid>
            </Canvas>
        </Viewbox>

        <!-- Indication pour passer l'intro -->
        <TextBlock x:Name="SkipHint" Text="Cliquez pour passer" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Tertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" IsHitTestVisible="False" />
    </Grid>
</UserControl>
