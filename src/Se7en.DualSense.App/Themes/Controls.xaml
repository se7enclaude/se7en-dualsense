<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Se7en.DualSense.App.Controls">

    <!-- ───────────── Typographie ───────────── -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Anton</FontFamily>
    <FontFamily x:Key="Font.Sans">pack://application:,,,/Assets/Fonts/#Hanken Grotesk</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Assets/Fonts/#Geist Mono</FontFamily>
    <FontFamily x:Key="Font.Glyph">Segoe UI Symbol</FontFamily>

    <LinearGradientBrush x:Key="Gradient.Lavender" StartPoint="0,0" EndPoint="1,0.6">
        <GradientStop Color="#B687E5" Offset="0" />
        <GradientStop Color="#8F9BEA" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LightBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#004B57F5" Offset="0" />
        <GradientStop Color="#FF4B57F5" Offset="0.45" />
        <GradientStop Color="#004B57F5" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="42" />
    </Style>
    <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    </Style>
    <Style x:Key="Text.Readout" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <!-- ───────────── Icône ───────────── -->
    <Style TargetType="c:AxisIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AxisIcon">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────── Carte neumorphique (sans bordure) ───────────── -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Tag" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="20" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.Highlight}" />
                        <Border CornerRadius="20" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.Low}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card.Small" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="20" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.HighlightSm}" />
                        <Border CornerRadius="20" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.LowSm}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────── Badge ───────────── -->
    <Style TargetType="c:Badge">
        <Setter Property="Background" Value="{DynamicResource Neutral.Soft}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Badge">
                    <Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="10,0" Height="24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{TemplateBinding Foreground}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{StaticResource Font.Sans}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Accent}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                <Setter Property="Foreground" Value="{DynamicResource Success}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Danger.Soft}" />
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ───────────── Boutons ───────────── -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="19" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Hover}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource Shadow.Glow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Press}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="19" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Inverse}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Inverse}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton icône fantôme (barre de titre, actions de carte) -->
    <Style x:Key="IconButton.Ghost" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Veil}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton.Close" TargetType="Button" BasedOn="{StaticResource IconButton.Ghost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────── Élément de navigation (sidebar) ───────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="ShadowHi" CornerRadius="14" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.HighlightSm}" Opacity="0" />
                        <Border x:Name="ShadowLo" CornerRadius="14" Background="{DynamicResource Surface.Card}" Effect="{DynamicResource Shadow.LowSm}" Opacity="0" />
                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:AxisIcon x:Name="Ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                            Foreground="{TemplateBinding Foreground}" Width="18" Height="18" />
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Font.Sans}"
                                                  TextElement.FontSize="14" TextElement.FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Veil}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="ShadowHi" Property="Opacity" Value="1" />
                            <Setter TargetName="ShadowLo" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────── Barre de défilement fine ───────────── -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource Border.Default}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
