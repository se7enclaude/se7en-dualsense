<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Axis (itération 2, éditoriale) — thème clair : gris neutres, encre, accent violet, surbrillance citron. -->
    <Color x:Key="Color.Accent">#5B2DE0</Color>
    <Color x:Key="Color.AccentSoft">#EFEAFD</Color>
    <Color x:Key="Color.Highlight">#D4F53C</Color>
    <Color x:Key="Color.Ink">#111114</Color>
    <Color x:Key="Color.Danger">#E0353B</Color>

    <SolidColorBrush x:Key="Ink" Color="#111114" />
    <SolidColorBrush x:Key="OnInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Highlight" Color="#D4F53C" />
    <SolidColorBrush x:Key="OnHighlight" Color="#111114" />
    <SolidColorBrush x:Key="Signal" Color="#1A1AF0" />

    <SolidColorBrush x:Key="Surface.Page" Color="#E7E8EB" />
    <SolidColorBrush x:Key="Surface.Card" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#DCDDE1" />
    <SolidColorBrush x:Key="Surface.Solid" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Inverse" Color="#111114" />

    <SolidColorBrush x:Key="Text.Primary" Color="#111114" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#53565F" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#6C6F79" />
    <SolidColorBrush x:Key="Text.Inverse" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Accent" Color="#5B2DE0" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#14111114" />
    <SolidColorBrush x:Key="Border.Default" Color="#24111114" />
    <SolidColorBrush x:Key="Border.Strong" Color="#111114" />
    <SolidColorBrush x:Key="Border.Dashed" Color="#52111114" />
    <SolidColorBrush x:Key="Border.Hairline" Color="#17111114" />

    <SolidColorBrush x:Key="Accent" Color="#5B2DE0" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#4A20C2" />
    <SolidColorBrush x:Key="Accent.Press" Color="#381795" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#EFEAFD" />
    <SolidColorBrush x:Key="Accent.Line" Color="#9F84F0" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#17A06B" />
    <SolidColorBrush x:Key="Success.Text" Color="#117850" />
    <SolidColorBrush x:Key="Success.Soft" Color="#D7F2E6" />
    <SolidColorBrush x:Key="Warning" Color="#D98A1C" />
    <SolidColorBrush x:Key="Warning.Text" Color="#8D5A12" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#F8E8CF" />
    <SolidColorBrush x:Key="Danger" Color="#E0353B" />
    <SolidColorBrush x:Key="Danger.Text" Color="#A8282C" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#F9DADB" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#DCDDE1" />
    <SolidColorBrush x:Key="Veil" Color="#14111114" />

    <!-- Ombres : seulement pour les calques flottants (produit, dialogues, toasts) -->
    <DropShadowEffect x:Key="Shadow.Pop" Color="#111114" Direction="270" ShadowDepth="16" BlurRadius="48" Opacity="0.3" />
    <DropShadowEffect x:Key="Shadow.Float" Color="#111114" Direction="270" ShadowDepth="24" BlurRadius="56" Opacity="0.32" />
    <DropShadowEffect x:Key="Shadow.Glow" Color="#5B2DE0" Direction="270" ShadowDepth="4" BlurRadius="22" Opacity="0.45" />
</ResourceDictionary>
