<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Axis — thème sombre : surfaces quasi noires bleutées, ombres plates, accent bleu 400. -->
    <Color x:Key="Color.Accent">#4B57F5</Color>
    <Color x:Key="Color.AccentSoft">#294B57F5</Color>
    <Color x:Key="Color.Danger">#E0353B</Color>
    <Color x:Key="Color.ShadowLow">#000000</Color>

    <SolidColorBrush x:Key="Surface.Page" Color="#101116" />
    <SolidColorBrush x:Key="Surface.Card" Color="#17191F" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#1E2028" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#0B0C10" />
    <SolidColorBrush x:Key="Surface.Solid" Color="#22252D" />
    <SolidColorBrush x:Key="Surface.Inverse" Color="#EEF0F5" />

    <SolidColorBrush x:Key="Text.Primary" Color="#F1F2F6" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A3A9B7" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#7C8292" />
    <SolidColorBrush x:Key="Text.Inverse" Color="#22252C" />
    <SolidColorBrush x:Key="Text.Accent" Color="#8C95F8" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Border.Default" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Border.Strong" Color="#F1F2F6" />

    <SolidColorBrush x:Key="Accent" Color="#4B57F5" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#6570F7" />
    <SolidColorBrush x:Key="Accent.Press" Color="#1A1AF0" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#294B57F5" />
    <SolidColorBrush x:Key="Accent.Line" Color="#8C95F8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#17A06B" />
    <SolidColorBrush x:Key="Success.Soft" Color="#2917A06B" />
    <SolidColorBrush x:Key="Warning" Color="#D98A1C" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#29D98A1C" />
    <SolidColorBrush x:Key="Danger" Color="#E0353B" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#29E0353B" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#1E2028" />
    <SolidColorBrush x:Key="Veil" Color="#14FFFFFF" />

    <DropShadowEffect x:Key="Shadow.Highlight" Color="White" Direction="90" ShadowDepth="1" BlurRadius="0" Opacity="0.04" />
    <DropShadowEffect x:Key="Shadow.Low" Color="Black" Direction="270" ShadowDepth="16" BlurRadius="40" Opacity="0.6" />
    <DropShadowEffect x:Key="Shadow.HighlightSm" Color="White" Direction="90" ShadowDepth="1" BlurRadius="0" Opacity="0.04" />
    <DropShadowEffect x:Key="Shadow.LowSm" Color="Black" Direction="270" ShadowDepth="8" BlurRadius="18" Opacity="0.55" />
    <DropShadowEffect x:Key="Shadow.Pop" Color="Black" Direction="270" ShadowDepth="12" BlurRadius="40" Opacity="0.5" />
    <DropShadowEffect x:Key="Shadow.Glow" Color="#4B57F5" Direction="270" ShadowDepth="4" BlurRadius="22" Opacity="0.5" />
</ResourceDictionary>
