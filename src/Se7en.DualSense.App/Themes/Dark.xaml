<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Axis (itération 2, éditoriale) — thème sombre : surfaces quasi noires, l'encre devient blanc cassé, accent violet 400. -->
    <Color x:Key="Color.Accent">#7B57EA</Color>
    <Color x:Key="Color.AccentSoft">#2E7B57EA</Color>
    <Color x:Key="Color.Highlight">#D4F53C</Color>
    <Color x:Key="Color.Ink">#F7F7F8</Color>
    <Color x:Key="Color.Danger">#E0353B</Color>

    <SolidColorBrush x:Key="Ink" Color="#F7F7F8" />
    <SolidColorBrush x:Key="OnInk" Color="#111114" />
    <SolidColorBrush x:Key="Highlight" Color="#D4F53C" />
    <SolidColorBrush x:Key="OnHighlight" Color="#111114" />
    <SolidColorBrush x:Key="Signal" Color="#4B57F5" />

    <SolidColorBrush x:Key="Surface.Page" Color="#0F0F12" />
    <SolidColorBrush x:Key="Surface.Card" Color="#17171B" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#1F1F24" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#0A0A0C" />
    <SolidColorBrush x:Key="Surface.Solid" Color="#232328" />
    <SolidColorBrush x:Key="Surface.Inverse" Color="#F2F3F5" />

    <SolidColorBrush x:Key="Text.Primary" Color="#F3F3F5" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A4A6AE" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#7D808A" />
    <SolidColorBrush x:Key="Text.Inverse" Color="#111114" />
    <SolidColorBrush x:Key="Text.Accent" Color="#9F84F0" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Border.Default" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Border.Strong" Color="#F3F3F5" />
    <SolidColorBrush x:Key="Border.Dashed" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="Border.Hairline" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="Accent" Color="#7B57EA" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#9273EE" />
    <SolidColorBrush x:Key="Accent.Press" Color="#5B2DE0" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#2E7B57EA" />
    <SolidColorBrush x:Key="Accent.Line" Color="#9F84F0" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#17A06B" />
    <SolidColorBrush x:Key="Success.Text" Color="#3CC48C" />
    <SolidColorBrush x:Key="Success.Soft" Color="#2917A06B" />
    <SolidColorBrush x:Key="Warning" Color="#D98A1C" />
    <SolidColorBrush x:Key="Warning.Text" Color="#E8A646" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#29D98A1C" />
    <SolidColorBrush x:Key="Danger" Color="#E0353B" />
    <SolidColorBrush x:Key="Danger.Text" Color="#F0646A" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#29E0353B" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#1F1F24" />
    <SolidColorBrush x:Key="Veil" Color="#14FFFFFF" />

    <DropShadowEffect x:Key="Shadow.Pop" Color="Black" Direction="270" ShadowDepth="16" BlurRadius="48" Opacity="0.55" />
    <DropShadowEffect x:Key="Shadow.Float" Color="Black" Direction="270" ShadowDepth="24" BlurRadius="56" Opacity="0.6" />
    <DropShadowEffect x:Key="Shadow.Glow" Color="#7B57EA" Direction="270" ShadowDepth="4" BlurRadius="22" Opacity="0.5" />
</ResourceDictionary>
