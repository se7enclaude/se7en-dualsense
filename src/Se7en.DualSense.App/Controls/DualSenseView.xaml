<UserControl x:Class="Se7en.DualSense.App.Controls.DualSenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!--
        DualSense photographique (Assets/Images/dualsense.png, 505 × 386 px) avec des calques animés
        posés exactement sur chaque commande. Les coordonnées sont en pixels de la photo.
    -->
    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <RadialGradientBrush x:Key="StickWell" GradientOrigin="0.5,0.4">
            <GradientStop Color="#0B0C10" Offset="0.55" />
            <GradientStop Color="#1C1E24" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
    <!-- Affiché si la photo de la manette est absente (non versionnée, voir README) -->
    <TextBlock x:Name="MissingPhoto" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#6B7282"
               Text="Image de la manette absente. Placez dualsense.png, stick-left.png et stick-right.png dans Assets/Images (voir README)." />
    <Viewbox x:Name="Stage" Stretch="Uniform">
        <Canvas Width="505" Height="420">

            <!-- Ombre au sol (se resserre quand la manette monte) -->
            <Ellipse x:Name="FloorShadow" Canvas.Left="62" Canvas.Top="352" Width="380" Height="40" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="FloorShadowScale" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#58181C2C" Offset="0" />
                        <GradientStop Color="#00181C2C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Canvas x:Name="Body" Width="505" Height="386">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="Tilt" CenterX="252" CenterY="190" />
                        <TranslateTransform x:Name="Float" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Lueur des gâchettes L2 / R2 (derrière la manette) -->
                <Ellipse x:Name="L2Glow" Canvas.Left="78" Canvas.Top="14" Width="74" Height="26" Opacity="0">
                    <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="R2Glow" Canvas.Left="353" Canvas.Top="14" Width="74" Height="26" Opacity="0">
                    <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                </Ellipse>

                <!-- Photo -->
                <Image x:Name="Photo" Width="505" Height="386"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Barre lumineuse : recolorée avec la couleur réellement envoyée à la manette -->
                <Path x:Name="LightbarGlowL" Data="M 162,45 C 166,75 171,100 180,118" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                    <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                </Path>
                <Path x:Name="LightbarGlowR" Data="M 343,45 C 339,75 334,100 325,118" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                    <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                </Path>
                <Path x:Name="LightbarL" Data="M 162,45 C 166,75 171,100 180,118" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="LightbarR" Data="M 343,45 C 339,75 334,100 325,118" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- Pavé tactile : teinte au clic + doigts -->
                <Path x:Name="TouchTint" Opacity="0"
                      Data="M 166,40 L 339,40 L 328,114 C 325,123 320,127 311,127 L 194,127 C 185,127 180,123 177,114 Z" />
                <Canvas>
                    <Canvas.Clip>
                        <PathGeometry Figures="M 166,40 L 339,40 L 328,114 C 325,123 320,127 311,127 L 194,127 C 185,127 180,123 177,114 Z" />
                    </Canvas.Clip>
                    <Ellipse x:Name="Finger0" Width="16" Height="16" Opacity="0">
                        <Ellipse.Effect><DropShadowEffect x:Name="Finger0Glow" ShadowDepth="0" BlurRadius="14" Opacity="0.9" /></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="Finger1" Width="16" Height="16" Opacity="0">
                        <Ellipse.Effect><DropShadowEffect x:Name="Finger1Glow" ShadowDepth="0" BlurRadius="14" Opacity="0.9" /></Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- L1 / R1 -->
                <Path x:Name="L1Over" Opacity="0" Data="M 85,49 L 88,38 C 90,33 96,31 104,31 L 138,31 C 142,31 144,34 144,38 L 144,45 Z" />
                <Path x:Name="R1Over" Opacity="0" Data="M 420,49 L 417,38 C 415,33 409,31 401,31 L 367,31 C 363,31 361,34 361,38 L 361,45 Z" />

                <!-- Create / Options -->
                <Rectangle x:Name="CreateOver" Canvas.Left="143" Canvas.Top="55" Width="12" Height="22" RadiusX="6" RadiusY="6" Opacity="0" />
                <Rectangle x:Name="OptionsOver" Canvas.Left="350" Canvas.Top="54" Width="12" Height="22" RadiusX="6" RadiusY="6" Opacity="0" />

                <!-- Croix directionnelle -->
                <Path x:Name="DpadUpOver" Opacity="0" Data="M 104,78 Q 101,78 101,82 L 101,101 L 114,111 L 127,101 L 127,82 Q 127,78 124,78 Z" />
                <Path x:Name="DpadDownOver" Opacity="0" Data="M 104,151 Q 101,151 101,147 L 101,128 L 114,118 L 127,128 L 127,147 Q 127,151 124,151 Z" />
                <Path x:Name="DpadLeftOver" Opacity="0" Data="M 81,101 Q 77,101 77,105 L 77,124 Q 77,128 81,128 L 100,128 L 110,114.5 L 100,101 Z" />
                <Path x:Name="DpadRightOver" Opacity="0" Data="M 147,101 Q 151,101 151,105 L 151,124 Q 151,128 147,128 L 128,128 L 118,114.5 L 128,101 Z" />

                <!-- Boutons de façade -->
                <Grid x:Name="TriangleOver" Canvas.Left="375.5" Canvas.Top="66.5" Width="31" Height="31" Opacity="0">
                    <Ellipse x:Name="TriangleFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="△" Margin="0,-2,0,0" />
                </Grid>
                <Grid x:Name="SquareOver" Canvas.Left="342.5" Canvas.Top="98.5" Width="31" Height="31" Opacity="0">
                    <Ellipse x:Name="SquareFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="□" FontSize="15" />
                </Grid>
                <Grid x:Name="CircleOver" Canvas.Left="408.5" Canvas.Top="98.5" Width="31" Height="31" Opacity="0">
                    <Ellipse x:Name="CircleFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="○" />
                </Grid>
                <Grid x:Name="CrossOver" Canvas.Left="375.5" Canvas.Top="131.5" Width="31" Height="31" Opacity="0">
                    <Ellipse x:Name="CrossFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="✕" FontSize="13" />
                </Grid>

                <!-- Sticks : le chapeau d'origine est masqué par un puits sombre, la copie se déplace -->
                <Ellipse Canvas.Left="153.7" Canvas.Top="147.3" Width="56" Height="56" Fill="{StaticResource StickWell}" />
                <Ellipse Canvas.Left="296.2" Canvas.Top="147.3" Width="56" Height="56" Fill="{StaticResource StickWell}" />
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="LeftStickShift" /></Canvas.RenderTransform>
                    <Image x:Name="StickLeftImage" Canvas.Left="153" Canvas.Top="146" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="6" Opacity="0.45" /></Image.Effect>
                    </Image>
                    <Ellipse x:Name="LeftStickRing" Canvas.Left="155.2" Canvas.Top="148.8" Width="53" Height="53" StrokeThickness="2.2" />
                </Canvas>
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="RightStickShift" /></Canvas.RenderTransform>
                    <Image x:Name="StickRightImage" Canvas.Left="295" Canvas.Top="146" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="6" Opacity="0.45" /></Image.Effect>
                    </Image>
                    <Ellipse x:Name="RightStickRing" Canvas.Left="297.7" Canvas.Top="148.8" Width="53" Height="53" StrokeThickness="2.2" />
                </Canvas>

                <!-- PS / micro -->
                <Ellipse x:Name="PsOver" Canvas.Left="241" Canvas.Top="160" Width="24" Height="24" Opacity="0" StrokeThickness="2" />
                <Rectangle x:Name="MuteOver" Canvas.Left="242" Canvas.Top="196" Width="22" Height="6" RadiusX="3" RadiusY="3" Opacity="0" />
            </Canvas>
        </Canvas>
    </Viewbox>
    </Grid>
</UserControl>
