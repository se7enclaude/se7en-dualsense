<UserControl x:Class="Se7en.DualSense.App.Controls.DualSenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!--
        DualSense (rendu 3D Blender, Assets/Images/dualsense.png en 1515 × 1158, affiché dans un repère
        505 × 386) avec des calques animés posés exactement sur chaque commande.
    -->
    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <RadialGradientBrush x:Key="StickWell" GradientOrigin="0.5,0.4">
            <GradientStop Color="#0B0C10" Offset="0.55" />
            <GradientStop Color="#1C1E24" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
    <!-- Affiché si l'image de la manette est absente (non versionnée, voir README) -->
    <TextBlock x:Name="MissingPhoto" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#6B7282"
               Text="Image de la manette absente. Placez dualsense.png, stick-left.png et stick-right.png dans Assets/Images (voir README)." />
    <Viewbox x:Name="Stage" Stretch="Uniform">
        <Canvas Width="505" Height="420">

            <!-- Ombre au sol (se resserre quand la manette monte) -->
            <Ellipse x:Name="FloorShadow" Canvas.Left="62" Canvas.Top="352" Width="380" Height="40" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="FloorShadowScale" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#58181C2C" Offset="0" />
                        <GradientStop Color="#00181C2C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Canvas x:Name="Body" Width="505" Height="386">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="Tilt" CenterX="252" CenterY="190" />
                        <TranslateTransform x:Name="Float" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Lueur des gâchettes L2 / R2 (derrière la manette) -->
                <Ellipse x:Name="L2Glow" Canvas.Left="70" Canvas.Top="26" Width="76" Height="26" Opacity="0">
                    <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="R2Glow" Canvas.Left="359" Canvas.Top="26" Width="76" Height="26" Opacity="0">
                    <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                </Ellipse>

                <!-- Rendu de la manette -->
                <Image x:Name="Photo" Width="505" Height="386" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Barre lumineuse : recolorée avec la couleur réellement envoyée à la manette -->
                <Path x:Name="LightbarGlowL" Data="M 155,58 C 158,85 162,110 170,130" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                    <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                </Path>
                <Path x:Name="LightbarGlowR" Data="M 350,58 C 347,85 343,110 335,130" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5">
                    <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                </Path>
                <Path x:Name="LightbarL" Data="M 155,58 C 158,85 162,110 170,130" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="LightbarR" Data="M 350,58 C 347,85 343,110 335,130" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- Pavé tactile : teinte au clic + doigts -->
                <Path x:Name="TouchTint" Opacity="0"
                      Data="M 159,52 L 346,52 L 338,118 C 335,135 328,146 315,146 L 190,146 C 177,146 170,135 167,118 Z" />
                <Canvas>
                    <Canvas.Clip>
                        <PathGeometry Figures="M 159,52 L 346,52 L 338,118 C 335,135 328,146 315,146 L 190,146 C 177,146 170,135 167,118 Z" />
                    </Canvas.Clip>
                    <Ellipse x:Name="Finger0" Width="16" Height="16" Opacity="0">
                        <Ellipse.Effect><DropShadowEffect x:Name="Finger0Glow" ShadowDepth="0" BlurRadius="14" Opacity="0.9" /></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="Finger1" Width="16" Height="16" Opacity="0">
                        <Ellipse.Effect><DropShadowEffect x:Name="Finger1Glow" ShadowDepth="0" BlurRadius="14" Opacity="0.9" /></Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- L1 / R1 -->
                <Path x:Name="L1Over" Opacity="0" Data="M 76,62 L 77,55 C 80,50 90,47 104,46 L 134,45 C 138,45 140,48 139,52 L 139,56 Z" />
                <Path x:Name="R1Over" Opacity="0" Data="M 429,62 L 428,55 C 425,50 415,47 401,46 L 371,45 C 367,45 365,48 366,52 L 366,56 Z" />

                <!-- Create / Options -->
                <Rectangle x:Name="CreateOver" Canvas.Left="136" Canvas.Top="64" Width="12" Height="25" RadiusX="6" RadiusY="6" Opacity="0" />
                <Rectangle x:Name="OptionsOver" Canvas.Left="357" Canvas.Top="64" Width="12" Height="25" RadiusX="6" RadiusY="6" Opacity="0" />

                <!-- Croix directionnelle -->
                <Path x:Name="DpadUpOver" Opacity="0" Data="M 95,90 Q 91,90 91,94 L 91,113 L 105,122 L 119,113 L 119,94 Q 119,90 115,90 Z" />
                <Path x:Name="DpadDownOver" Opacity="0" Data="M 95,169 Q 91,169 91,165 L 91,145 L 105,136 L 119,145 L 119,165 Q 119,169 115,169 Z" />
                <Path x:Name="DpadLeftOver" Opacity="0" Data="M 68,115 Q 64,115 64,119 L 64,139 Q 64,143 68,143 L 87,143 L 97,129 L 87,115 Z" />
                <Path x:Name="DpadRightOver" Opacity="0" Data="M 142,115 Q 146,115 146,119 L 146,139 Q 146,143 142,143 L 123,143 L 113,129 L 123,115 Z" />

                <!-- Boutons de façade -->
                <Grid x:Name="TriangleOver" Canvas.Left="385" Canvas.Top="78" Width="32" Height="32" Opacity="0">
                    <Ellipse x:Name="TriangleFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="△" Margin="0,-2,0,0" />
                </Grid>
                <Grid x:Name="SquareOver" Canvas.Left="350" Canvas.Top="114" Width="32" Height="32" Opacity="0">
                    <Ellipse x:Name="SquareFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="□" FontSize="16" />
                </Grid>
                <Grid x:Name="CircleOver" Canvas.Left="420" Canvas.Top="114" Width="32" Height="32" Opacity="0">
                    <Ellipse x:Name="CircleFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="○" />
                </Grid>
                <Grid x:Name="CrossOver" Canvas.Left="385" Canvas.Top="149" Width="32" Height="32" Opacity="0">
                    <Ellipse x:Name="CrossFill" />
                    <TextBlock Style="{StaticResource Glyph}" Text="✕" FontSize="14" />
                </Grid>

                <!-- Sticks : le chapeau d'origine est masqué par un puits sombre, la copie se déplace -->
                <Ellipse Canvas.Left="148" Canvas.Top="166" Width="54" Height="54" Fill="{StaticResource StickWell}" />
                <Ellipse Canvas.Left="299" Canvas.Top="166" Width="54" Height="54" Fill="{StaticResource StickWell}" />
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="LeftStickShift" /></Canvas.RenderTransform>
                    <Image x:Name="StickLeftImage" Canvas.Left="147" Canvas.Top="165" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="6" Opacity="0.45" /></Image.Effect>
                    </Image>
                    <Ellipse x:Name="LeftStickRing" Canvas.Left="149" Canvas.Top="167" Width="52" Height="52" StrokeThickness="2.2" />
                </Canvas>
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="RightStickShift" /></Canvas.RenderTransform>
                    <Image x:Name="StickRightImage" Canvas.Left="298" Canvas.Top="165" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect><DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="6" Opacity="0.45" /></Image.Effect>
                    </Image>
                    <Ellipse x:Name="RightStickRing" Canvas.Left="300" Canvas.Top="167" Width="52" Height="52" StrokeThickness="2.2" />
                </Canvas>

                <!-- PS / micro -->
                <Ellipse x:Name="PsOver" Canvas.Left="240" Canvas.Top="179" Width="26" Height="26" Opacity="0" StrokeThickness="2" />
                <Rectangle x:Name="MuteOver" Canvas.Left="242" Canvas.Top="218" Width="22" Height="6" RadiusX="3" RadiusY="3" Opacity="0" />
            </Canvas>
        </Canvas>
    </Viewbox>
    </Grid>
</UserControl>
